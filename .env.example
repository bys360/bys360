# BYS360 .env.example
# Gerçek parola, token, DSN veya bağlantı bilgisi içermez.
# Bu dosya repoda kalabilir; gerçek .env proje dışı/güvenli alanda tutulmalıdır.

# BYS360_LOCAL_SQLITE_SCHEMA_BOOTSTRAP_V2: local kalici SQLite veritabani
DATABASE_URL=sqlite:///instance/bys360_local_dev.sqlite3

# BYS360 Dosya Merkezi canlı ayarları
# Canlıda mutlaka gerçek kalıcı disk/volume yolu verin. Windows örnek: D:/bys360_storage/file_center
# Linux örnek: /var/lib/bys360/file_center
FILE_CENTER_STORAGE_ROOT=
FILE_CENTER_ENABLED=false
FILE_CENTER_GUEST_LINKS_ENABLED=false
FILE_CENTER_GUEST_UPLOADS_ENABLED=false
FILE_CENTER_SECURITY_SCAN_ENABLED=true
FILE_CENTER_AUTO_SCAN_ON_UPLOAD=true
FILE_CENTER_REQUIRE_CLEAN_BEFORE_DOWNLOAD=true
FILE_CENTER_CLAMAV_ENABLED=false
FILE_CENTER_CLAMAV_COMMAND=clamscan --no-summary --infected
FILE_CENTER_CLAMAV_TIMEOUT_SECONDS=60
FILE_CENTER_DISK_ALERT_PERCENT=85
FILE_CENTER_GUEST_DOWNLOAD_RATE_LIMIT=20 per hour
FILE_CENTER_GUEST_UPLOAD_RATE_LIMIT=10 per hour
FILE_CENTER_AUTH_UPLOAD_RATE_LIMIT=30 per hour
FILE_CENTER_CHUNK_PART_RATE_LIMIT=240 per hour
ENABLE_API_RATE_LIMIT=true
RATELIMIT_STORAGE_URI=memory://


# Kurumsal mail / SMTP örnekleri - gerçek şifre yazmayın
MAIL_SERVER=
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_USE_TLS=false
MAIL_USE_SSL=false
APP_BASE_URL=http://127.0.0.1:8000

# BYS360_HANDOVER_ENV_CATALOG_V1_BEGIN
# Devredilebilirlik katalo??u: ger??ek parola/token/DSN yazmay??n.
# Bo?? b??rak??lan de??erler iste??e ba??l??d??r veya ortamda g??venli bi??imde sa??lanmal??d??r.
APP_ENV=development
APP_HOST=127.0.0.1
APP_LOG_BACKUP_COUNT=10
APP_LOG_FILE_MAX_BYTES=10485760
APP_NAME=BYS360
APP_PORT=8000
BYS360_DEFAULT_FIRST_LOGIN_PASSWORD=
BYS360_DEPLOYMENT_MODE=local
BYS360_ENV=development
BYS360_EXECUTIVE_SUMMARY_RECIPIENTS=
BYS360_FEEDBACK_FOLLOWUP_DAYS_AHEAD=7
BYS360_FEEDBACK_FOLLOWUP_SCHEDULER=false
BYS360_FEEDBACK_FOLLOWUP_SCHEDULER_INTERVAL_MINUTES=60
BYS360_INSTAGRAM_ACCESS_TOKEN=
BYS360_INSTAGRAM_ACCOUNTS=
BYS360_INSTAGRAM_API_VERSION=v23.0
BYS360_INSTAGRAM_CASAMER_ID=
BYS360_INSTAGRAM_PORTAL_AUTHOR_EMAIL=
BYS360_INSTAGRAM_PORTAL_AUTHOR_USER_ID=
BYS360_INSTAGRAM_STORY_LIMIT=25
BYS360_INSTAGRAM_STORY_TTL_HOURS=24
BYS360_INSTAGRAM_SYNC_LIMIT=25
BYS360_INSTAGRAM_TARIHIALAN_ID=
BYS360_LOAD_PASSWORD=
BYS360_LOAD_USERNAME=
BYS360_LOG_DIR=logs
BYS360_OUTBOUND_HTTP_TIMEOUT=15
BYS360_PRESS_NEWS_ALLOWED_HOSTS=
BYS360_PRESS_NEWS_QUERIES=
BYS360_PROJECT_ROOT=C:/bys360/project
BYS360_RUN_LEGACY_ARCHITECTURE_TESTS=false
BYS360_SMOKE_BASE_URL=http://127.0.0.1:8000
BYS360_SMOKE_REQUIRE_HTTP=false
BYS360_SMOKE_TIMEOUT=15
BYS360_SOCIAL_INSTAGRAM_ACCOUNTS=
BYS360_SOCIAL_X_ACCOUNTS=
BYS360_SUMMARY_ACTIVE_SURVEYS=0
BYS360_SUMMARY_OPEN_SUPPORT=0
BYS360_SUMMARY_PENDING_APPROVALS=0
BYS360_SUMMARY_PENDING_FEEDBACK=0
BYS360_SUMMARY_PENDING_PERFORMANCE=0
BYS360_TESTING=false
BYS360_WEATHER_HUMIDITY=
BYS360_WEATHER_LAT=
BYS360_WEATHER_LOCATION=Canakkale
BYS360_WEATHER_LON=
BYS360_WEATHER_RAIN=
BYS360_WEATHER_STATUS=
BYS360_WEATHER_TEMP=
BYS360_WEATHER_WIND=
CSP_ALLOW_UNSAFE_INLINE_SCRIPT=false
CSP_ENABLED=true
CSP_NONCE_ENABLED=true
CSP_REPORT_ONLY=false
# BYS360_CSP_STYLE1_V1: style-src-elem / style-src-attr icin varsayilanlar
# mevcut style-src ile ayni sekilde 'unsafe-inline' icerir; bu satirlar sadece
# config.py varsayilanini belgeler ve davranisi degistirmeyen no-op degerlerdir.
CSP_STYLE_SRC_ATTR="'unsafe-inline'"
CSP_STYLE_SRC_ELEM="'self' 'unsafe-inline' https:"
DB_ALLOW_SSL_DISABLE=false
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=1800
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=30
DB_POOL_USE_LIFO=true
DB_SSLMODE=prefer
FILE_CENTER_AUTO_REMINDER_DAYS=3
FILE_CENTER_AUTO_REMINDER_RESEND_HOURS=24
FILE_CENTER_CHUNK_FINALIZE_RATE_LIMIT=30 per hour
FILE_CENTER_CHUNK_SESSION_RATE_LIMIT=60 per hour
FILE_CENTER_MAIL_FROM=
FILE_CENTER_MAIL_FROM_NAME=BYS360
FILE_CENTER_MAX_FILE_GB=5
FILE_CENTER_MAX_TRANSFER_GB=20
FILE_CENTER_PUBLIC_BASE_URL=http://127.0.0.1:8000
FILE_CENTER_SMTP_HOST=
FILE_CENTER_SMTP_PASSWORD=
FILE_CENTER_SMTP_PORT=25
FILE_CENTER_SMTP_USER=
FLASK_ENV=development
FLASK_SECRET=
FLASK_SKIP_SCHEMA_VALIDATION=false
HSTS_POLICY=max-age=31536000; includeSubDomains
LOG_FOLDER=logs
LOG_LEVEL=INFO
PREFERRED_URL_SCHEME=https
PROXY_FIX_ENABLED=true
PROXY_FIX_X_FOR=1
PROXY_FIX_X_HOST=1
PROXY_FIX_X_PORT=1
PROXY_FIX_X_PREFIX=1
PROXY_FIX_X_PROTO=1
REDIS_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
REDIS_URL=redis://127.0.0.1:6379/0
SECRET_KEY=
SECURITY_LOG_COOLDOWN_SECONDS=60
SECURITY_RATE_LIMIT_BACKEND=memory
SECURITY_RATE_LIMIT_FILE=
SECURITY_RATE_LIMIT_REDIS_URL=
SECURITY_RATE_LIMIT_SHARED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_RELEASE=
SENTRY_REQUIRED_IN_PRODUCTION=false
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=0
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
SESSION_REFRESH_EACH_REQUEST=true
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=25
SMTP_SENDER=
SMTP_USERNAME=
# BYS360_SEC3C_A1_TRUSTED_HOSTS_V1: Flask'in yerlesik Host-header dogrulamasi
# icin ek, virgulle ayrilmis guvenilir host listesi. APP_BASE_URL'in kendi
# host'u HER ZAMAN otomatik eklenir; production/staging'de bu deger asla
# bos/None kalmaz ve '*' (wildcard) kesinlikle reddedilir.
TRUSTED_HOSTS=bys360.canakkaletarihialan.gov.tr
UPLOAD_FOLDER=instance/uploads
UPLOAD_MAX_FILENAME_LENGTH=180
UPLOAD_STRICT_MIME_VALIDATION=true
WAITRESS_THREADS=8
# Waitress ters proxy guveni (app/core/waitress_proxy.py). Bos = hicbir proxy'ye guvenilmez;
# X-Forwarded-For/-Proto/-Host/-Port Waitress tarafindan silinir. Yalniz Waitress'in onunde
# gercekten bir ters proxy varsa ve operator adresini dogruladiysa doldurun. Tek IP adresi
# ('*', liste, ag veya host adi kabul edilmez); katman sayisi 1-10; basliklar yalniz
# x-forwarded-for, x-forwarded-proto, x-forwarded-host, x-forwarded-port. Gecersiz deger
# run_server.py'nin baslamasini durdurur. Ornek (canli deger DEGIL):
#   WAITRESS_TRUSTED_PROXY=127.0.0.1
#   WAITRESS_TRUSTED_PROXY_COUNT=1
#   WAITRESS_TRUSTED_PROXY_HEADERS=x-forwarded-for x-forwarded-proto x-forwarded-host x-forwarded-port
WAITRESS_TRUSTED_PROXY=
WAITRESS_TRUSTED_PROXY_COUNT=
WAITRESS_TRUSTED_PROXY_HEADERS=
# BYS360_HANDOVER_ENV_CATALOG_V1_END
