# BYS360 Nginx örnek konfigürasyonu
# Amaç: SSL termination, reverse proxy, gzip ve statik dosya servis örneği.
# Not: upstream portunu canlı servis tipine göre ayarlayın.
# - Linux/gunicorn örneği: 127.0.0.1:8000
# - Windows/Waitress arkasında kullanılacaksa Waitress'in dinlediği iç port yazılır.

upstream bys360_app {
    server 127.0.0.1:8000;
    keepalive 32;
}

server {
    listen 80;
    server_name bys360.example.gov.tr;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name bys360.example.gov.tr;

    # Kuruma ait gerçek sertifika yolları ile değiştirin.
    ssl_certificate     /etc/nginx/ssl/bys360.fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/bys360.privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:BYS360SSL:10m;
    ssl_prefer_server_ciphers off;

    client_max_body_size 25m;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # B2-F06: app/static/uploads altındaki eski özel yüklemeler (mesaj, destek, portal,
    # İK, yayın, profil fotoğrafı) /static'ten sunulmaz; uygulama onları yetki kontrolü
    # yapan route'larla sunar. ^~ ile en uzun önek olarak /static/ bloğunun önüne geçer.
    location ^~ /static/uploads/ {
        return 404;
    }

    location /static/ {
        alias /opt/bys360/project/app/static/;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        access_log off;
    }

    location /uploads/ {
        # Dosya erişiminde uygulama yetki kontrolü tercih edilmelidir.
        # Doğrudan servis gerekiyorsa bu yol kurum politikasına göre açılmalıdır.
        internal;
        alias /opt/bys360/project/uploads/;
    }

    location / {
        proxy_pass http://bys360_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
        proxy_connect_timeout 30s;
        proxy_send_timeout 120s;
    }
}
